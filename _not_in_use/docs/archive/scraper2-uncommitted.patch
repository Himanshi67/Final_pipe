+def parse_dynamic_attributes_from_html(html_content, category_family=''):
+    if not html_content or not isinstance(html_content, str):
+        return []
+
+    family = compact(category_family)
+    family_prefix_map = {
+        'Washing Machines': 'WM',
+        'Air Conditioner': 'AC',
+        'Water Heaters': 'GY',
+    }
+    family_prefix = family_prefix_map.get(family, '')
+
+    function_label = 'Function Type'
+    capacity_label = 'Capacity'
+    if family_prefix:
+        function_label = f'{family_prefix} Function Type'
+        capacity_label = f'{family_prefix} Capacity'
+    if family == 'Washing Machines':
+        capacity_label = 'WM Washing Capacity'
+    elif family == 'Air Conditioner':
+        capacity_label = 'AC Cooling Capacity'
+    elif family == 'Water Heaters':
+        capacity_label = 'GY Tank Volume'
+
+    li_matches = re.findall(r'<li>(.*?)</li>', html_content, re.IGNORECASE | re.DOTALL)
+    parsed_attributes = []
+    attribute_name_map = {
+        'brand': 'Brand',
+        'configuration': function_label,
+        'function type': function_label,
+        'washing capacity': capacity_label,
+        'cooling capacity': capacity_label,
+        'storage capacity': capacity_label,
+        'tank volume': capacity_label,
+        'capacity': capacity_label,
+        'power rating': 'Power Rating',
+        'rated power': 'Power Rating',
+        'water level': 'Water Level',
+        'control type': 'Control Type',
+    }
+
+    for item in li_matches:
+        if ':' not in item:
+            continue
+
+        name_part, value_part = item.split(':', 1)
+        attr_name = compact(name_part)
+        attr_value = compact(value_part).rstrip('.')
+
+        if not attr_name or not attr_value:
+            continue
+
+        normalized_name = compact(attribute_name_map.get(attr_name.lower(), attr_name))
+
+        if not normalized_name:
+            continue
+
+        parsed_attributes.append((normalized_name, attr_value))
+
+    return parsed_attributes
+
