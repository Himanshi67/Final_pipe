# Python environment and cache
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Local environment/secrets files
.env
.env.*
!.env.example
*.secret
*.secrets

# Browser clearance cookie for wc_publish.py --cookie-file. A live session
# credential for the storefront - never commit it.
cookie.txt
cookie*.txt
*.cookie

# OS / editor noise
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build / packaging artifacts
build/
dist/
*.egg-info/

# Runtime-generated catalogue outputs
*_filled.xlsx
*_recovery.xlsx
wordpress_ready*.csv
validation_issues.csv
product_images_for_upload/
*_report.md
seo_changes.csv

# Generated blog drafts and their briefs. Regenerable from the catalogue.
blog_automate/out/

# Page/search cache (sku_enricher --cache-*). Regenerable, and a full batch is
# a few hundred MB of compressed HTML.
.cache/

# Store checkpoints (wc_checkpoint.py). These are copies of live product data,
# including whatever meta the plugins keep - not something to push to a remote.
# They are also the rollback, so do NOT delete them casually.
checkpoints/

# runs/<name>/ - the loose CSVs and logs one run leaves behind (seo_apply.log,
# seo_dryrun.csv, a _filled.xlsx, ...). Kept on disk for reference, out of git.
# Anything worth keeping gets promoted to batches/<name>/ instead.
runs/

# inputs/ - source SKU lists. Customer data, and already covered by *.xlsx.
inputs/

# Archived batches (batches/<name>/) and dated file backups. Kept on disk,
# out of git - a single batch is ~30 MB of .webp.
batches/
backups/

# _push_export is a SEPARATE nested repo with its own remote. Committing it from
# the outer repo records a gitlink that no clone can resolve. `git add -A` did
# exactly that once; this stops it happening again. Commit inside it instead.
_push_export/

# Local input datasets and exports
*.xlsx
*.xls
*.tsv

# ...EXCEPT the taxonomy, which is configuration, not data. app.py cannot map a
# single category without it, and it has no other backup. Must come after the
# *.xlsx rule above to override it.
!category_map.xlsx
!SubCategory_Attributes_Master.xlsx
# curated per-category tags and SEO keywords - hand-written configuration,
# regenerable with tools\build_category_seo.py but edited by hand in between
!category_seo.xlsx

# Nothing in here belongs to the catalogue pipeline - a portable Node
# distribution plus scratch DSA work. Ignoring the whole folder rather than
# just _tools/ stops `git add -A` sweeping another session's files into a
# pipeline commit, which happened once.
Code_Unrelated/

# The original 518 MB scraper (2) drop, .git and .venv included. Its source is
# archived at docs/archive/scraper2-source.zip (0.27 MB) and the working copy
# was merged in and removed - this is just the download.
/scraper (2).zip

graphify-out/

# Per-machine Claude Code settings. Only settings.json (shared: agents, skills,
# project permissions) is tracked; the .local one holds this machine's own
# allowlist. Previously this was ignored only by a global gitignore on one
# machine, so a fresh clone elsewhere would have committed it.
.claude/settings.local.json

# Planning docs that stay OFF the public remote (origin is a public GitHub repo).
# They live on disk and CLAUDE.md points at them, but they are never committed:
#   NEXT_STEPS.md  - the open-defect list for a live storefront's pipeline
#   PRODUCT_PLAN.md - pricing, revenue projections, client names, and notes on
#                     what outside work the owner's employer permits
# If this repo ever becomes private, delete these two lines and commit them.
docs/NEXT_STEPS.md
docs/PRODUCT_PLAN.md
# Session handovers summarising the same open-defect material.
docs/handover-audit-productization.md
docs/handover-phase0-closeout.md
